Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:app|config|cron|database|storage|page-content|wordpress-plugin|releases)(?:/|$) - [F,L,NC]
    RewriteRule ^public/(?!assets/) - [F,L,NC]
</IfModule>

<FilesMatch "^(\.env|composer\.(json|lock)|README\.md)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(?:sql|log|ini)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
</IfModule>
